{
  "name": "ask-anurag",
  "version": "1.0.0",
  "description": "Anurag Yadav's portfolio with AI Anurag, a guarded resume chatbot on a serverless Node.js function.",
  "type": "module",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "dev": "node scripts/build.ts && node dev-server.mjs",
    "dev:mock": "node scripts/build.ts && node dev-server.mjs --mock",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "og": "node scripts/og.ts",
    "eval": "node evals/run-evals.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
