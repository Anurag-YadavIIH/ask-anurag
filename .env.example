# Copy to .env.local for local testing. On Vercel, add these in
# Project Settings > Environment Variables. Never commit real keys.

# Required: your Groq API key (console.groq.com > API Keys)
LLM_API_KEY=

# Optional: switch provider or model (any OpenAI-compatible API)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b

# Optional: limits
# PER_VISITOR_DAILY=5
# GLOBAL_DAILY=300

# Recommended on Vercel: Upstash Redis so limits survive restarts (free tier)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: random string used when hashing visitor IPs
# IP_SALT=change-me

# Optional: only needed if the chat is called from a different domain
# ALLOWED_ORIGINS=https://anurag-yadaviih.github.io
